{
	"name": "@kitschpatrol/create-project",
	"version": "1.11.0",
	"description": "Kitschpatrol's TypeScript project templates.",
	"keywords": [
		"cli",
		"template",
		"bingo",
		"npm-package"
	],
	"homepage": "https://github.com/kitschpatrol/create-project",
	"bugs": "https://github.com/kitschpatrol/create-project/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/create-project.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"sideEffects": false,
	"type": "module",
	"bin": "dist/index.js",
	"files": [
		"dist",
		"templates",
		"!**/node_modules",
		"!**/.agents",
		"!**/.claude",
		"!**/skills-lock.json"
	],
	"scripts": {
		"build": "tsdown",
		"clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX -e !.claude/",
		"fix": "ksc fix --skip mdat && mdat readme.md",
		"lint": "ksc lint --skip mdat && mdat check readme.md",
		"prepare": "skills experimental_sync -y -f",
		"release": "bumpp --commit 'Release: %s' && pnpm build && NPM_TOKEN=$(op read 'op://Personal/npm/token') pnpm publish --otp $(op item get npm --otp)",
		"test": "vitest run",
		"update-templates": "for dir in ./templates/*; do taze -w --cwd \"$dir\"; done",
		"update-templates-major": "for dir in ./templates/*; do taze major -w --cwd \"$dir\" --exclude @types/node,typescript,vite; done"
	},
	"dependencies": {
		"bingo": "^0.13.2",
		"bingo-fs": "^0.6.0",
		"handlebars": "^4.7.10",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@kitschpatrol/shared-config": "^8.13.1",
		"@types/node": "~24.13.6",
		"bumpp": "^12.3.0",
		"mdat": "^3.6.2",
		"mdat-plugin-cli-help": "^3.4.1",
		"shx": "^0.4.0",
		"skills": "^1.7.1",
		"taze": "^21.3.0",
		"tsdown": "^0.23.0",
		"typescript": "~6.0.3",
		"vitest": "^5.0.3"
	},
	"packageManager": "pnpm@12.10.1",
	"engines": {
		"node": "^24.16.0 || >=26.3.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
