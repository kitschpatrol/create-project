{
	"name": "{{{github-repository}}}",
	"version": "0.0.0",
	"private": true,
	"description": "A {{{type}}} project.",
	"keywords": [
		"{{{type}}}"
	],
	"homepage": "https://github.com/{{{github-owner}}}/{{{github-repository}}}",
	"bugs": "https://github.com/{{{github-owner}}}/{{{github-repository}}}/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/{{{github-owner}}}/{{{github-repository}}}.git"
	},
	"license": "MIT",
	"author": {
		"name": "{{{author-name}}}",
		"email": "{{{author-email}}}",
		"url": "{{{author-url}}}"
	},
	"sideEffects": false,
	"type": "module",
	"scripts": {
		"bench": "vitest bench --run",
		"bench:baseline": "vitest bench --run",
		"build": "shx rm -rf dist && vite build && tsx ./scripts/versions.ts > ./dist/{{{github-repository}}}/version.json",
		"clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX -e !.claude/",
		"dev": "poptab && vite",
		"fix": "ksc fix",
		"lint": "ksc lint",
		"prepare": "skills experimental_sync -y -f",
		"preview": "pnpm build && poptab && tsx ./scripts/preview.ts",
		"release": "bumpp --commit 'Release: %s' && pnpm build && wrangler deploy",
		"test": "vitest run"
	},
	"devDependencies": {
		"@kitschpatrol/shared-config": "^8.13.1",
		"@types/node": "~24.13.6",
		"bumpp": "^12.3.0",
		"open": "^11.0.4",
		"poptab": "^1.2.2",
		"shx": "^0.4.0",
		"skills": "^1.7.1",
		"tsx": "^4.23.15",
		"typescript": "~6.0.3",
		"vite": "^8.3.3",
		"vite-plugin-mkcert": "~2.1.0",
		"vitest": "^5.0.3",
		"wrangler": "^4.148.0"
	},
	"packageManager": "pnpm@12.10.1",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^26.10.0"
		}
	}
}
