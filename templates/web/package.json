{
	"name": "{{{github-repository}}}",
	"version": "0.0.0",
	"private": true,
	"description": "A {{{type}}} project.",
	"keywords": [
		"{{{type}}}"
	],
	"homepage": "https://github.com/{{{github-owner}}}/{{{github-repository}}}",
	"bugs": "https://github.com/{{{github-owner}}}/{{{github-repository}}}/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/{{{github-owner}}}/{{{github-repository}}}.git"
	},
	"license": "MIT",
	"author": {
		"name": "{{{author-name}}}",
		"email": "{{{author-email}}}",
		"url": "{{{author-url}}}"
	},
	"sideEffects": false,
	"type": "module",
	"scripts": {
		"bench": "vitest bench --run",
		"bench:baseline": "vitest bench --run",
		"build": "vite build",
		"clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX -e !.claude/",
		"dev": "poptab && vite",
		"fix": "ksc fix",
		"lint": "ksc lint",
		"preview": "poptab && vite preview",
		"release": "bumpp --commit 'Release: %s'",
		"test": "vitest run"
	},
	"devDependencies": {
		"@kitschpatrol/shared-config": "^8.10.1",
		"@types/node": "~24.13.6",
		"bumpp": "^12.3.0",
		"poptab": "^1.2.1",
		"shx": "^0.4.0",
		"typescript": "~6.0.3",
		"vite": "^8.3.1",
		"vite-plugin-mkcert": "~2.1.0",
		"vitest": "^5.0.2"
	},
	"packageManager": "pnpm@12.6.0",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^26.10.0"
		}
	}
}
