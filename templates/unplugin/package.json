{
	"name": "{{{github-repository}}}",
	"version": "0.0.0",
	"description": "An unplugin project.",
	"keywords": [
		"unplugin",
		"vite",
		"webpack",
		"rspack",
		"rollup",
		"rolldown",
		"esbuild",
		"farm",
		"bun",
		"transform",
		"npm-package"
	],
	"homepage": "https://github.com/{{{github-owner}}}/{{{github-repository}}}",
	"bugs": "https://github.com/{{{github-owner}}}/{{{github-repository}}}/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/{{{github-owner}}}/{{{github-repository}}}.git"
	},
	"license": "MIT",
	"author": {
		"name": "{{{author-name}}}",
		"email": "{{{author-email}}}",
		"url": "{{{author-url}}}"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./dist/index.js",
		"./*": "./*",
		"./api": "./dist/api.js",
		"./bun": "./dist/bun.js",
		"./esbuild": "./dist/esbuild.js",
		"./farm": "./dist/farm.js",
		"./rolldown": "./dist/rolldown.js",
		"./rollup": "./dist/rollup.js",
		"./rspack": "./dist/rspack.js",
		"./vite": "./dist/vite.js",
		"./webpack": "./dist/webpack.js"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"typesVersions": {
		"*": {
			"*": [
				"./dist/*",
				"./*"
			]
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"bench": "vitest bench --run",
		"bench:baseline": "vitest bench --run",
		"build": "tsdown",
		"clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX -e !.claude/",
		"dev": "tsdown --watch",
		"fix": "ksc fix",
		"lint": "ksc lint",
		"play": "poptab && pnpm -C playground run dev",
		"release": "bumpp --commit 'Release: %s' && pnpm build && NPM_TOKEN=$({{{npm-token-command}}}) pnpm publish --otp $({{{npm-otp-command}}})",
		"test": "vitest run"
	},
	"dependencies": {
		"@types/node": "~24.13.6",
		"unplugin": "^3.4.0"
	},
	"devDependencies": {
		"@farmfe/core": ">=1.7.11",
		"@kitschpatrol/shared-config": "^8.10.1",
		"@vitest/browser-playwright": "^5.0.2",
		"bumpp": "^12.3.0",
		"esbuild": "*",
		"poptab": "^1.2.1",
		"rolldown": "^1.2.11",
		"rollup": "^4.63.5",
		"shx": "^0.4.0",
		"tsdown": "^0.23.0",
		"typescript": "~6.0.3",
		"vite": "^8.3.1",
		"vitest": "^5.0.2",
		"webpack": "^5.111.1"
	},
	"peerDependencies": {
		"@farmfe/core": ">=1",
		"esbuild": "*",
		"rolldown": "^1",
		"rollup": "^4.1",
		"vite": ">=3",
		"webpack": "^4 || ^5"
	},
	"peerDependenciesMeta": {
		"@farmfe/core": {
			"optional": true
		},
		"esbuild": {
			"optional": true
		},
		"rolldown": {
			"optional": true
		},
		"rollup": {
			"optional": true
		},
		"vite": {
			"optional": true
		},
		"webpack": {
			"optional": true
		}
	},
	"packageManager": "pnpm@12.6.0",
	"engines": {
		"node": "^24.16.0 || >=26.3.0"
	}
}
