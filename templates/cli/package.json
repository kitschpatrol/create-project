{
	"name": "{{{github-repository}}}",
	"version": "0.0.0",
	"description": "A {{{type}}} project.",
	"keywords": [
		"cli",
		"npm-package"
	],
	"homepage": "https://github.com/{{{github-owner}}}/{{{github-repository}}}",
	"bugs": "https://github.com/{{{github-owner}}}/{{{github-repository}}}/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/{{{github-owner}}}/{{{github-repository}}}.git"
	},
	"license": "MIT",
	"author": {
		"name": "{{{author-name}}}",
		"email": "{{{author-email}}}",
		"url": "{{{author-url}}}"
	},
	"sideEffects": false,
	"type": "module",
	"bin": {
		"{{{cli-command-name}}}": "dist/index.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"bench": "vitest bench --run",
		"bench:baseline": "vitest bench --run",
		"build": "tsdown",
		"clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX -e !.claude/",
		"fix": "ksc fix",
		"lint": "ksc lint",
		"release": "bumpp --commit 'Release: %s' && pnpm build && NPM_TOKEN=$({{{npm-token-command}}}) pnpm publish --otp $({{{npm-otp-command}}})",
		"test": "vitest run"
	},
	"dependencies": {
		"@types/yargs": "^17.0.35",
		"lognow": "^0.8.2",
		"yargs": "^18.1.0"
	},
	"devDependencies": {
		"@kitschpatrol/shared-config": "^8.9.0",
		"@types/node": "~24.13.4",
		"bumpp": "^12.3.0",
		"mdat-plugin-cli-help": "^3.2.0",
		"publint": "^0.3.24",
		"shx": "^0.4.0",
		"tsdown": "^0.23.0",
		"typescript": "~6.0.3",
		"vitest": "^5.0.1"
	},
	"packageManager": "pnpm@12.4.0",
	"engines": {
		"node": "^24.16.0 || >=26.3.0"
	}
}
