{
	"name": "{{{github-repository}}}",
	"version": "0.0.0",
	"description": "A {{{type}}} project.",
	"keywords": [
		"npm-package"
	],
	"homepage": "https://github.com/{{{github-owner}}}/{{{github-repository}}}",
	"bugs": "https://github.com/{{{github-owner}}}/{{{github-repository}}}/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/{{{github-owner}}}/{{{github-repository}}}.git"
	},
	"license": "MIT",
	"author": {
		"name": "{{{author-name}}}",
		"email": "{{{author-email}}}",
		"url": "{{{author-url}}}"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"files": [
		"dist"
	],
	"scripts": {
		"bench": "vitest bench --run",
		"bench:baseline": "vitest bench --run",
		"build": "tsdown",
		"clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX -e !.claude/",
		"fix": "ksc fix",
		"lint": "ksc lint",
		"prepare": "skills experimental_sync -y -f",
		"release": "bumpp --commit 'Release: %s' && pnpm build && NPM_TOKEN=$({{{npm-token-command}}}) pnpm publish --otp $({{{npm-otp-command}}})",
		"test": "vitest run"
	},
	"dependencies": {
		"@types/node": "~24.13.6",
		"lognow": "^0.8.5"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.5",
		"@kitschpatrol/shared-config": "^8.13.1",
		"bumpp": "^12.3.0",
		"publint": "^0.3.25",
		"shx": "^0.4.0",
		"skills": "^1.7.1",
		"tsdown": "^0.23.0",
		"typescript": "~6.0.3",
		"vitest": "^5.0.3"
	},
	"packageManager": "pnpm@12.10.1",
	"engines": {
		"node": "^24.16.0 || >=26.3.0"
	}
}
